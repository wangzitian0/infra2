# Store the real URLs only in /etc/infra2/host-guard.env (root:root, 0600).
# Set three different Healthchecks.io checks with independent notification routes.
HOST_HEARTBEAT_PING_URL=https://hc-ping.com/replace-with-host-check-uuid
DISK_GUARDIAN_WARNING_PING_URL=https://hc-ping.com/replace-with-disk-warning-check-uuid
DISK_GUARDIAN_PING_URL=https://hc-ping.com/replace-with-disk-critical-check-uuid
