#!/usr/sbin/nft -f
# infra2 host firewall. SSOT: docs/ssot/bootstrap.nodep.md §4 "Host firewall" (Infra-022 T1.3, #724).
#
# Public surface of the VPS: SSH (22) and the Traefik entrypoints (80, 443, 443/udp). Everything else that
# listens on the public interface is refused. As of 2026-09-17 that means:
#   - Dokploy's UI on 3000; operators use https://cloud.<domain> or an SSH tunnel;
#   - the single-node swarm's control plane (2377/tcp), gossip (7946/tcp+udp) and VXLAN data plane (4789/udp).
#
# Origin protection (#724-R1): ports 80/tcp, 443/tcp, and 443/udp on the public interface accept traffic
# only from Cloudflare edge IPv4/IPv6 ranges (@cf_ipv4 / @cf_ipv6), in both `input` and `forward` (for
# Docker DNAT). SSH (22/tcp) remains open to any source IP.
#
# This table is ours alone. It never flushes the ruleset: Docker (iptables-nft `ip filter`/`ip nat`) and
# fail2ban (`inet f2b-table`) own their own tables. A packet must pass every base chain on a hook, so a drop here
# is final and an accept here does not bypass theirs.
#
# Docker-published IPv4 ports are DNAT'd in prerouting and reach containers through FORWARD, not INPUT. So the
# Dokploy port and direct non-Cloudflare hits to 80/443 are dropped in `forward`, by their original destination
# port. Published IPv6 ports are served by docker-proxy on the host, so `input` covers them.

define PUBLIC_IF = "eth0"

table inet infra2_hostfw
delete table inet infra2_hostfw

table inet infra2_hostfw {
	set cf_ipv4 {
		type ipv4_addr
		flags interval
		elements = {
			103.21.244.0/22,
			103.22.200.0/22,
			103.31.4.0/22,
			104.16.0.0/13,
			104.24.0.0/14,
			108.162.192.0/18,
			131.0.72.0/22,
			141.101.64.0/18,
			162.158.0.0/15,
			172.64.0.0/13,
			173.245.48.0/20,
			188.114.96.0/20,
			190.93.240.0/20,
			197.234.240.0/22,
			198.41.128.0/17
		}
	}

	set cf_ipv6 {
		type ipv6_addr
		flags interval
		elements = {
			2400:cb00::/32,
			2405:8100::/32,
			2405:b500::/32,
			2606:4700::/32,
			2803:f800::/32,
			2a06:98c0::/29,
			2c0f:f248::/32
		}
	}

	set public_tcp {
		type inet_service
		elements = { 22, 80, 443 }
	}

	# 443: HTTP/3 on Traefik. 68/546: DHCPv4/DHCPv6 client replies.
	set public_udp {
		type inet_service
		elements = { 68, 443, 546 }
	}

	# Host-bound traffic arriving on the public interface: allow-list, default drop.
	chain input {
		type filter hook input priority filter; policy accept;
		iifname != $PUBLIC_IF accept
		ct state established,related accept
		meta l4proto { icmp, ipv6-icmp } accept
		tcp dport 22 accept
		ip saddr @cf_ipv4 tcp dport { 80, 443 } accept
		ip6 saddr @cf_ipv6 tcp dport { 80, 443 } accept
		ip saddr @cf_ipv4 udp dport 443 accept
		ip6 saddr @cf_ipv6 udp dport 443 accept
		udp dport { 68, 546 } accept
		counter drop comment "infra2-hostfw: not on the public allow-list"
	}

	# Runs before Docker's FORWARD (priority filter). Drops direct non-CF hits to 80/443 and external hits on Dokploy UI (3000).
	chain forward {
		type filter hook forward priority filter - 1; policy accept;
		iifname $PUBLIC_IF meta l4proto tcp ct original proto-dst 3000 counter drop comment "infra2-hostfw: Dokploy UI is not public"
		iifname $PUBLIC_IF ip saddr != @cf_ipv4 meta l4proto tcp ct original proto-dst { 80, 443 } counter drop comment "infra2-hostfw: non-CF IPv4 direct hit on 80/443"
		iifname $PUBLIC_IF ip6 saddr != @cf_ipv6 meta l4proto tcp ct original proto-dst { 80, 443 } counter drop comment "infra2-hostfw: non-CF IPv6 direct hit on 80/443"
		iifname $PUBLIC_IF ip saddr != @cf_ipv4 meta l4proto udp ct original proto-dst 443 counter drop comment "infra2-hostfw: non-CF IPv4 direct hit on 443/udp"
		iifname $PUBLIC_IF ip6 saddr != @cf_ipv6 meta l4proto udp ct original proto-dst 443 counter drop comment "infra2-hostfw: non-CF IPv6 direct hit on 443/udp"
	}
}
