{{- /* Generated from bootstrap/iac_runner by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/bootstrap/%s/iac_runner" $env) }}
WEBHOOK_SECRET={{ printf "%q" .Data.data.WEBHOOK_SECRET }}
GIT_REPO_URL={{ printf "%q" .Data.data.GIT_REPO_URL }}
VPS_HOST={{ printf "%q" .Data.data.VPS_HOST }}
DOKPLOY_API_KEY={{ printf "%q" .Data.data.DOKPLOY_API_KEY }}
{{ with index .Data.data "OP_SERVICE_ACCOUNT_TOKEN" }}OP_SERVICE_ACCOUNT_TOKEN={{ printf "%q" . }}{{ end }}
{{- end }}
