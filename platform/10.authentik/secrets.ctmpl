{{- /* Generated from platform/authentik by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/platform/%s/postgres" $env) }}
PG_PASS={{ printf "%q" .Data.data.root_password }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ printf "%q" .Data.data.root_password }}
{{- end }}
{{- with secret (printf "secret/data/platform/%s/redis" $env) }}
REDIS_PASSWORD={{ printf "%q" .Data.data.password }}
AUTHENTIK_REDIS__PASSWORD={{ printf "%q" .Data.data.password }}
{{- end }}
{{- with secret (printf "secret/data/platform/%s/authentik" $env) }}
AUTHENTIK_SECRET_KEY={{ printf "%q" .Data.data.secret_key }}
{{ with index .Data.data "bootstrap_password" }}AUTHENTIK_BOOTSTRAP_PASSWORD={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "bootstrap_email" }}AUTHENTIK_BOOTSTRAP_EMAIL={{ printf "%q" . }}{{ end }}
{{- end }}
