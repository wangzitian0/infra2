{
  "title": "Platform Todo — HTTP Service",
  "description": "Request rate, 5xx share, p50/p95 latency and active requests of platform-todo (new HTTP convention: http.server.request.duration.*). Probe traffic is included. The 5xx share reads the OpenTelemetry attribute http.response.status_code: confirm the series carries it after the first apply. Metric names were read from SigNoz on 2026-11-10 (read-only). LLM panels (gen_ai.*, read from SigNoz staging on 2026-11-20, read-only) chart token usage, operation duration, and operation.cost and token spans per infra.llm.call_site. Applied by `invoke fr-observability.shared.apply-dashboard`. Environments are deployment.environment.name.",
  "tags": ["platform-todo", "infra2", "config-as-code"],
  "version": "v5",
  "variables": {
    "deployment_environment": {
      "type": "QUERY",
      "name": "deployment_environment",
      "description": "deployment.environment.name (production / staging / pr-N)",
      "multiSelect": true,
      "showALLOption": true,
      "queryValue": "SELECT DISTINCT resources_string['deployment.environment.name'] FROM signoz_logs.distributed_logs_v2 WHERE resources_string['deployment.environment.name'] != ''"
    }
  },
  "widgets": [
    {"id": "todo-request-rate", "title": "Request rate", "description": "Requests per second (http.server.request.duration.count).", "panelTypes": "graph", "yAxisUnit": "reqps",
     "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "http.server.request.duration.count", "timeAggregation": "rate", "spaceAggregation": "sum"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "requests/s"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-error-rate-5xx", "title": "5xx share of requests", "description": "5xx requests divided by all requests (http.server.request.duration.count, attribute http.response.status_code).", "panelTypes": "graph", "yAxisUnit": "percentunit",
     "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "http.server.request.duration.count", "timeAggregation": "rate", "spaceAggregation": "sum"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND http.response.status_code REGEXP '^5[0-9][0-9]' AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "A", "disabled": true, "stepInterval": 60, "legend": "5xx"}, {"queryName": "B", "dataSource": "metrics", "aggregations": [{"metricName": "http.server.request.duration.count", "timeAggregation": "rate", "spaceAggregation": "sum"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "B", "disabled": true, "stepInterval": 60, "legend": "all"}], "queryFormulas": [{"queryName": "F1", "expression": "A/B", "disabled": false, "legend": "5xx share"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-latency", "title": "Request latency p50 / p95", "description": "p50 and p95 request duration from the histogram http.server.request.duration.bucket.", "panelTypes": "graph", "yAxisUnit": "s",
     "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "http.server.request.duration.bucket", "spaceAggregation": "p50"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "p50"}, {"queryName": "B", "dataSource": "metrics", "aggregations": [{"metricName": "http.server.request.duration.bucket", "spaceAggregation": "p95"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "B", "disabled": false, "stepInterval": 60, "legend": "p95"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-active-requests", "title": "Active requests", "description": "Requests in flight (http.server.active_requests).", "panelTypes": "graph",
     "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "http.server.active_requests", "timeAggregation": "latest", "spaceAggregation": "sum"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "active"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-probe-latency-p95", "title": "Canary Probe Latency (p95 ms)", "description": "p95 latency of canary dependency probes from canary.probe.duration_ms.bucket.", "panelTypes": "graph", "yAxisUnit": "ms",
     "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "canary.probe.duration_ms.bucket", "spaceAggregation": "p95"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "{{canary.check}}"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-probe-outcomes", "title": "Canary Probe Outcomes by Check", "description": "Rate of canary dependency probe outcomes by check and status (canary.probe.outcomes).", "panelTypes": "graph",
     "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "canary.probe.outcomes", "timeAggregation": "rate", "spaceAggregation": "sum"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "{{canary.check}} ({{canary.status}})"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-llm-token-usage", "title": "LLM token usage by type", "description": "Token rate by gen_ai.token.type (gen_ai.client.token.usage.sum). This metric carries no infra.llm.call_site label; the per-call-site split is on the span panel.", "panelTypes": "graph", "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "gen_ai.client.token.usage.sum", "timeAggregation": "rate", "spaceAggregation": "sum"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "groupBy": [{"dataType": "string", "key": "gen_ai.token.type", "type": "tag"}], "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "{{gen_ai.token.type}}"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-llm-operation-duration", "title": "LLM operation duration p50 / p95 by call site", "description": "p50 and p95 of gen_ai.client.operation.duration.bucket, split by infra.llm.call_site.", "panelTypes": "graph", "yAxisUnit": "s", "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "metrics", "aggregations": [{"metricName": "gen_ai.client.operation.duration.bucket", "spaceAggregation": "p50"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "groupBy": [{"dataType": "string", "key": "infra.llm.call_site", "type": "tag"}], "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "p50 {{infra.llm.call_site}}"}, {"queryName": "B", "dataSource": "metrics", "aggregations": [{"metricName": "gen_ai.client.operation.duration.bucket", "spaceAggregation": "p95"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment)"}, "groupBy": [{"dataType": "string", "key": "infra.llm.call_site", "type": "tag"}], "having": {"expression": ""}, "expression": "B", "disabled": false, "stepInterval": 60, "legend": "p95 {{infra.llm.call_site}}"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-llm-cost-by-call-site", "title": "LLM cost by call site", "description": "Sum of the span attribute operation.cost on chat spans (gen_ai.operation.name = chat), split by infra.llm.call_site. operation.cost is a span attribute, not a metric.", "panelTypes": "graph", "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "traces", "aggregations": [{"expression": "sum(operation.cost)"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment AND gen_ai.operation.name = 'chat') AND operation.cost EXISTS"}, "groupBy": [{"dataType": "string", "key": "infra.llm.call_site", "type": "tag"}], "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "{{infra.llm.call_site}}"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null},
    {"id": "todo-llm-tokens-by-call-site", "title": "LLM tokens by call site", "description": "Sum of gen_ai.usage.input_tokens and gen_ai.usage.output_tokens on chat spans, split by infra.llm.call_site.", "panelTypes": "graph", "query": {"builder": {"queryData": [{"queryName": "A", "dataSource": "traces", "aggregations": [{"expression": "sum(gen_ai.usage.input_tokens)"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment AND gen_ai.operation.name = 'chat')"}, "groupBy": [{"dataType": "string", "key": "infra.llm.call_site", "type": "tag"}], "having": {"expression": ""}, "expression": "A", "disabled": false, "stepInterval": 60, "legend": "input {{infra.llm.call_site}}"}, {"queryName": "B", "dataSource": "traces", "aggregations": [{"expression": "sum(gen_ai.usage.output_tokens)"}], "filter": {"expression": "(service.name IN ['platform-todo', 'platform-todo-v4-14', 'platform-todo-v4-13'] AND deployment.environment.name IN $deployment_environment AND gen_ai.operation.name = 'chat')"}, "groupBy": [{"dataType": "string", "key": "infra.llm.call_site", "type": "tag"}], "having": {"expression": ""}, "expression": "B", "disabled": false, "stepInterval": 60, "legend": "output {{infra.llm.call_site}}"}]}, "queryType": "builder"},
     "opacity": "1", "nullZeroValues": "zero", "timePreferance": "GLOBAL_TIME", "softMin": null, "softMax": null, "selectedLogFields": null, "selectedTracesFields": null}
  ],
  "layout": [
    {"i": "todo-request-rate", "x": 0, "y": 0, "w": 6, "h": 6, "moved": false, "static": false},
    {"i": "todo-error-rate-5xx", "x": 6, "y": 0, "w": 6, "h": 6, "moved": false, "static": false},
