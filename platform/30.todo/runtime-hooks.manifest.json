            "issue": "wangzitian0/infra2#1823"
          },
          "scheduled_audit": {
            "reason": "staging_gate runs in staging.post only",
            "issue": "wangzitian0/infra2#1823"
          }
        }
      }
    },
    {
      "id": "prod_gate",
