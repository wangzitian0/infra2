{
  "schema_version": 3,
  "service": "platform/todo",
  "required_env": [
    "APP_URL"
  ],
  "optional_env": [
    "TARGET_URL"
  ],
  "checks": [
    {
      "id": "smoke",
      "argv": [
        "sh",
        "-c",
        "python3 probe_health.py \"${TARGET_URL:-$APP_URL}\""
      ],
      "needs": [
        "code",
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 60
    },
    {
      "id": "preview_gate",
      "argv": [
        "sh",
        "-c",
        "python3 probe_health.py \"${TARGET_URL:-$APP_URL}\" --require-service platform/todo"
      ],
      "needs": [
        "code",
        "running_service"
      ],
      "writes": false,
      "accepts_scale": false,
      "timeout_seconds": 120,
      "cells": {
        "remove": {
          "staging.post": {
            "reason": "preview_gate runs in preview.post only",
            "issue": "wangzitian0/infra2#1823"
          },
          "prod.post": {
            "reason": "preview_gate runs in preview.post only",
            "issue": "wangzitian0/infra2#1823"
          },
          "scheduled_audit": {
            "reason": "preview_gate runs in preview.post only",
            "issue": "wangzitian0/infra2#1823"
          }
        }
      }
    },
    {
