{
  "schema_version": 1,
  "service": "platform/todo",
  "slots": {
    "smoke": {
      "run": "python3 probe_health.py \"${TARGET_URL:-$APP_URL}\"",
      "timeout_seconds": 60,
      "required_env": [
        "APP_URL"
      ],
      "optional_env": [
        "TARGET_URL"
      ]
    },
    "preview_gate": {
      "run": "python3 probe_health.py \"${TARGET_URL:-$APP_URL}\" --require-service platform/todo",
      "timeout_seconds": 120,
      "required_env": [
        "APP_URL"
      ],
      "optional_env": [
        "TARGET_URL"
      ]
    },
    "staging_gate": {
      "run": "python3 probe_health.py \"${TARGET_URL:-$APP_URL}\" --require-service platform/todo",
      "timeout_seconds": 180,
      "required_env": [
        "APP_URL"
      ],
      "optional_env": [
        "TARGET_URL"
      ]
    },
    "scheduled_audit": {
      "run": "python3 probe_health.py \"${TARGET_URL:-$APP_URL}\" --require-service platform/todo",
      "timeout_seconds": 300,
      "required_env": [
        "APP_URL"
      ],
      "optional_env": [
        "TARGET_URL"
      ]
    }
  }
}
