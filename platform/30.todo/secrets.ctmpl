{{- /* Generated from platform/todo by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/platform/%s/redis" $env) }}
REDIS_PASSWORD={{ printf "%q" .Data.data.password }}
{{- end }}
{{- with secret (printf "secret/data/platform/%s/todo" $env) }}
CANARY_POSTGRES_PASSWORD={{ printf "%q" .Data.data.CANARY_POSTGRES_PASSWORD }}
{{ with index .Data.data "CANARY_S3_ACCESS_KEY" }}CANARY_S3_ACCESS_KEY={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "CANARY_S3_SECRET_KEY" }}CANARY_S3_SECRET_KEY={{ printf "%q" . }}{{ end }}
{{- end }}
