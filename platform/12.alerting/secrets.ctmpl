{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/platform/%s/alerting" $env) }}
ALERT_DELIVERY_MODE={{ with .Data.data.ALERT_DELIVERY_MODE }}{{ printf "%q" . }}{{ else }}"feishu_webhook"{{ end }}
FEISHU_WEBHOOK_URL={{ with .Data.data.FEISHU_WEBHOOK_URL }}{{ printf "%q" . }}{{ else }}""{{ end }}
FEISHU_APP_ID={{ with .Data.data.FEISHU_APP_ID }}{{ printf "%q" . }}{{ else }}""{{ end }}
FEISHU_APP_SECRET={{ with .Data.data.FEISHU_APP_SECRET }}{{ printf "%q" . }}{{ else }}""{{ end }}
FEISHU_CHAT_ID={{ with .Data.data.FEISHU_CHAT_ID }}{{ printf "%q" . }}{{ else }}""{{ end }}
FEISHU_API_BASE={{ with .Data.data.FEISHU_API_BASE }}{{ printf "%q" . }}{{ else }}"https://open.feishu.cn"{{ end }}
BRIDGE_BASIC_AUTH_USERNAME={{ with .Data.data.BRIDGE_BASIC_AUTH_USERNAME }}{{ printf "%q" . }}{{ else }}""{{ end }}
BRIDGE_BASIC_AUTH_PASSWORD={{ with .Data.data.BRIDGE_BASIC_AUTH_PASSWORD }}{{ printf "%q" . }}{{ else }}""{{ end }}
INFRA_PROBE_HEARTBEAT_URL={{ with .Data.data.INFRA_PROBE_HEARTBEAT_URL }}{{ printf "%q" . }}{{ else }}""{{ end }}
INFRA_PROBE_HEARTBEAT_TOKEN={{ with .Data.data.INFRA_PROBE_HEARTBEAT_TOKEN }}{{ printf "%q" . }}{{ else }}""{{ end }}
# Dokploy API key for the deploy-queue-guard sidecar. REQUIRED for the guard to
# do anything — it cannot list deployments to observe without it (and also uses
# it to kill when DEPLOY_GUARD_REMEDIATE=1). Populate in the alerting Vault
# secret; until set, the guard idles instead of crashlooping.
DOKPLOY_API_KEY={{ with .Data.data.DOKPLOY_API_KEY }}{{ printf "%q" . }}{{ else }}""{{ end }}
# Dedicated, minimal-privilege monitoring role for the platform-postgres-select1
# probe (kind="postgres", libs/infra_probes.py) — CONNECT only, no table grants;
# SELECT 1 needs nothing more. NOT the postgres root_password. One-time manual
# setup (platform/01.postgres/README.md's create-user pattern, minus the
# GRANT ALL — this role gets no grants at all):
#   invoke postgres.shared.create-user --username=probe_monitor --database=postgres --password=<generated>
# then store that password here. Empty until seeded -> the probe fails closed
# with "PROBE_POSTGRES_PASSWORD is not set" (diagnosable, not a silent miss).
PROBE_POSTGRES_USER={{ with .Data.data.PROBE_POSTGRES_USER }}{{ printf "%q" . }}{{ else }}"probe_monitor"{{ end }}
PROBE_POSTGRES_PASSWORD={{ with .Data.data.PROBE_POSTGRES_PASSWORD }}{{ printf "%q" . }}{{ else }}""{{ end }}
# Dedicated, minimal-privilege MinIO access key for the minio-s3-head-bucket
# probe (kind="s3", libs/infra_probes.py) — read-only policy scoped to ONE small
# healthcheck bucket, not the MinIO root credentials. One-time manual setup:
# create the bucket + a read-only-scoped access key via the MinIO admin
# console/`mc`, then store both here. Empty until seeded -> the probe fails
# closed with a clear "not set" detail, same as the postgres one above.
PROBE_S3_BUCKET={{ with .Data.data.PROBE_S3_BUCKET }}{{ printf "%q" . }}{{ else }}""{{ end }}
PROBE_S3_ACCESS_KEY={{ with .Data.data.PROBE_S3_ACCESS_KEY }}{{ printf "%q" . }}{{ else }}""{{ end }}
PROBE_S3_SECRET_KEY={{ with .Data.data.PROBE_S3_SECRET_KEY }}{{ printf "%q" . }}{{ else }}""{{ end }}
{{- end }}
