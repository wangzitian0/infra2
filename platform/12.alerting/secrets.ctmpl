{{- /* Generated from platform/alerting by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/platform/%s/alerting" $env) }}
ALERT_DELIVERY_MODE={{ printf "%q" .Data.data.ALERT_DELIVERY_MODE }}
{{ with .Data.data.FEISHU_WEBHOOK_URL }}FEISHU_WEBHOOK_URL={{ printf "%q" . }}{{ end }}
FEISHU_APP_ID={{ printf "%q" .Data.data.FEISHU_APP_ID }}
FEISHU_APP_SECRET={{ printf "%q" .Data.data.FEISHU_APP_SECRET }}
FEISHU_CHAT_ID={{ printf "%q" .Data.data.FEISHU_CHAT_ID }}
{{ with .Data.data.BRIDGE_BASIC_AUTH_USERNAME }}BRIDGE_BASIC_AUTH_USERNAME={{ printf "%q" . }}{{ end }}
{{ with .Data.data.BRIDGE_BASIC_AUTH_PASSWORD }}BRIDGE_BASIC_AUTH_PASSWORD={{ printf "%q" . }}{{ end }}
{{ with .Data.data.INFRA_PROBE_HEARTBEAT_URL }}INFRA_PROBE_HEARTBEAT_URL={{ printf "%q" . }}{{ end }}
{{ with .Data.data.INFRA_PROBE_HEARTBEAT_TOKEN }}INFRA_PROBE_HEARTBEAT_TOKEN={{ printf "%q" . }}{{ end }}
{{ with .Data.data.DOKPLOY_API_KEY }}DOKPLOY_API_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.PROBE_POSTGRES_PASSWORD }}PROBE_POSTGRES_PASSWORD={{ printf "%q" . }}{{ end }}
{{ with .Data.data.PROBE_S3_BUCKET }}PROBE_S3_BUCKET={{ printf "%q" . }}{{ end }}
{{ with .Data.data.PROBE_S3_ACCESS_KEY }}PROBE_S3_ACCESS_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.PROBE_S3_SECRET_KEY }}PROBE_S3_SECRET_KEY={{ printf "%q" . }}{{ end }}
{{- end }}
