{{- /* Generated from platform/minio by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/platform/%s/minio" $env) }}
MINIO_ROOT_USER={{ printf "%q" .Data.data.root_user }}
MINIO_ROOT_PASSWORD={{ printf "%q" .Data.data.root_password }}
{{- end }}
