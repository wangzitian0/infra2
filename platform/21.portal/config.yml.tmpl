---
title: "Infrastructure Portal"
subtitle: "Quick access to platform services"
icon: "fas fa-server"
header: true
footer: false
columns: "3"
connectivityCheck: true

defaults:
  layout: columns
  colorTheme: auto

links:
  - name: "Infra2 Repo"
    icon: "fab fa-github"
    url: "https://github.com/wangzitian0/infra2"
    target: "_blank"
  - name: "Docs"
    icon: "fas fa-book"
    url: "https://wangzitian0.github.io/infra2/"
    target: "_blank"
  - name: "Logout"
    icon: "fas fa-sign-out-alt"
    url: "https://sso{{ENV_DOMAIN_SUFFIX}}.{{INTERNAL_DOMAIN}}/application/o/portal/end-session/"
    target: "_self"

services:
  - name: "Platform Services"
    icon: "fas fa-server"
    items:
      - name: "Dokploy"
        icon: "fas fa-cloud"
        subtitle: "Control plane"
        tag: "platform"
        url: "https://cloud.{{INTERNAL_DOMAIN}}"
        target: "_blank"
      - name: "Vault"
        icon: "fas fa-lock"
        subtitle: "Secrets and KV"
        tag: "security"
        url: "https://vault.{{INTERNAL_DOMAIN}}"
        target: "_blank"
      - name: "Authentik SSO"
        icon: "fas fa-id-badge"
        subtitle: "Login and SSO"
        tag: "sso"
        url: "https://sso{{ENV_DOMAIN_SUFFIX}}.{{INTERNAL_DOMAIN}}"
        target: "_blank"
      - name: "1Password Connect"
        icon: "fas fa-key"
        subtitle: "Secrets sync API"
        tag: "secrets"
        url: "https://op.{{INTERNAL_DOMAIN}}/health"
        target: "_blank"
      - name: "Canary Todo"
        icon: "fas fa-check-double"
        subtitle: "Infra validation harness"
        tag: "canary"
        url: "https://todo{{ENV_DOMAIN_SUFFIX}}.{{INTERNAL_DOMAIN}}"
        target: "_blank"
  - name: "Observability & Workflows"
    icon: "fas fa-chart-line"
    items:
      - name: "SigNoz"
        icon: "fas fa-chart-area"
        subtitle: "Traces, metrics and logs"
        tag: "apm"
        url: "https://signoz{{ENV_DOMAIN_SUFFIX}}.{{INTERNAL_DOMAIN}}"
        target: "_blank"
      - name: "OpenPanel"
        icon: "fas fa-users"
        subtitle: "Product analytics and tracking"
        tag: "analytics"
        url: "https://openpanel{{ENV_DOMAIN_SUFFIX}}.{{INTERNAL_DOMAIN}}"
        target: "_blank"
      - name: "Prefect"
        icon: "fas fa-project-diagram"
        subtitle: "Workflow orchestration"
        tag: "workflows"
        url: "https://prefect{{ENV_DOMAIN_SUFFIX}}.{{INTERNAL_DOMAIN}}"
        target: "_blank"
      - name: "S3 Console"
        icon: "fas fa-database"
        subtitle: "Object storage bucket console"
        tag: "storage"
        url: "https://s3-console{{ENV_DOMAIN_SUFFIX}}.{{INTERNAL_DOMAIN}}"
        target: "_blank"

