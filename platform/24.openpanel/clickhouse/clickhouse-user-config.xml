<clickhouse>
    <profiles>
        <default>
            <log_queries>0</log_queries>
            <log_query_threads>0</log_query_threads>
            <!-- Rightsize: cap per-query parallelism (default auto = 8 = all
                 cores) on the shared host. Validated on 25.10.2.65. -->
            <max_threads>2</max_threads>
            <!-- Batch inserts on the server side to eliminate tiny parts and merge amplification -->
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
        </default>
    </profiles>
</clickhouse>
