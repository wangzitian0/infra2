{{- /* Generated from platform/openpanel by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/platform/%s/postgres" $env) }}
DATABASE_URL={{ printf "%q" (printf "postgresql://postgres:%s@platform-postgres%s:5432/openpanel" .Data.data.root_password (env "ENV_SUFFIX")) }}
DATABASE_URL_DIRECT={{ printf "%q" (printf "postgresql://postgres:%s@platform-postgres%s:5432/openpanel" .Data.data.root_password (env "ENV_SUFFIX")) }}
{{- end }}
{{- with secret (printf "secret/data/platform/%s/redis" $env) }}
REDIS_URL={{ printf "%q" (printf "redis://:%s@platform-redis%s:6379/3" .Data.data.password (env "ENV_SUFFIX")) }}
{{- end }}
{{- with secret (printf "secret/data/platform/%s/openpanel" $env) }}
COOKIE_SECRET={{ printf "%q" .Data.data.cookie_secret }}
RESEND_API_KEY={{ printf "%q" .Data.data.resend_api_key }}
{{- end }}
