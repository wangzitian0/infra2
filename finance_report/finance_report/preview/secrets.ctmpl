{{- /* Generated from finance_report/app by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/finance_report/%s/app" "staging") }}
{{ with index .Data.data "LLM_ENCRYPTION_KEYS" }}LLM_ENCRYPTION_KEYS={{ printf "%q" . }}{{ end }}
S3_ACCESS_KEY={{ printf "%q" .Data.data.S3_ACCESS_KEY }}
{{ with index .Data.data "S3_PUBLIC_ACCESS_KEY" }}S3_PUBLIC_ACCESS_KEY={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "S3_PUBLIC_SECRET_KEY" }}S3_PUBLIC_SECRET_KEY={{ printf "%q" . }}{{ end }}
S3_SECRET_KEY={{ printf "%q" .Data.data.S3_SECRET_KEY }}
SECRET_KEY={{ printf "%q" .Data.data.SECRET_KEY }}
{{ with index .Data.data "ZAI_API_KEY" }}ZAI_API_KEY={{ printf "%q" . }}{{ end }}
{{- end }}
