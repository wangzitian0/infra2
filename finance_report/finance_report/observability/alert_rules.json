{
  "$comment": "Config-as-code SigNoz alert rules for finance_report (#373/#1106/#906). The app references FinanceReportBackendErrorLogs in apps/backend/src/observability.py; this file is the reviewable source of truth. Applied idempotently by `invoke fr-observability.shared.apply-alerts`, which routes rules to the shared Feishu/Lark bridge channel. The SigNoz v5 payloads are derived from this shape by common/observability_dashboards.py + common/alerting.py. PromQL must select OTel metrics by their dotted names in the quoted form ({\"metric.name\",\"label.key\"=\"v\"}) because SigNoz runs with DOT_METRICS_ENABLED; per-rule thresholds, windows and absence choices are explained in docs/ssot/ops.observability.md SOP-004C. Rules here are service-specific; the standard error-log rules come from common/alerting/standard_rules.py. The environment is the {env} placeholder, filled by the loader for production and staging.",
  "service_id": "finance_report/app",
  "rules": [
    {
      "signal": "metrics",
      "alert_name": "FinanceReportHigh5xxRate",
      "service_name": "finance-report-backend",
      "severity": "critical",
      "threshold": 0.05,
      "threshold_unit": "%",
      "op": "above",
      "match_type": "at_least_once",
      "eval_window": "5m0s",
      "frequency": "1m",
      "promql": "(sum(increase({\"http.server.request.count\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\",\"http.response.status_code_class\"=\"5xx\"}[5m])) / sum(increase({\"http.server.request.count\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\"}[5m]))) and on() (sum(increase({\"http.server.request.count\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\",\"http.response.status_code_class\"=\"5xx\"}[5m])) >= 5)",
      "summary": "finance_report backend returned at least 5 HTTP 5xx and more than 5% 5xx across non-probe requests within 5 minutes. Severity P0. Runbook: docs/ssot/ops.observability.md SOP-004C."
    },
    {
      "signal": "metrics",
      "alert_name": "FinanceReportHigh5xxRateStable",
      "service_name": "finance-report-backend",
      "severity": "critical",
      "threshold": 0.05,
      "threshold_unit": "%",
      "op": "above",
      "match_type": "at_least_once",
      "eval_window": "5m0s",
      "frequency": "1m",
      "promql": "(sum(increase({\"http.server.request.duration.count\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\",\"http.response.status_code\"=~\"^5..$\"}[5m])) / sum(increase({\"http.server.request.duration.count\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\",\"http.response.status_code\"=~\"^.+$\"}[5m]))) and on() (sum(increase({\"http.server.request.duration.count\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\",\"http.response.status_code\"=~\"^5..$\"}[5m])) >= 5)",
      "summary": "finance_report backend returned at least 5 HTTP 5xx and more than 5% 5xx across non-probe requests within 5 minutes. Severity P0 (reads the stable HTTP metric http.server.request.duration; infra2#1465). Runbook: docs/ssot/ops.observability.md SOP-004C."
    },
    {
      "signal": "metrics",
      "alert_name": "FinanceReportP95LatencyHigh",
      "service_name": "finance-report-backend",
      "severity": "error",
      "threshold": 3000,
      "threshold_unit": "ms",
      "op": "above",
      "match_type": "all_times",
      "eval_window": "10m0s",
      "frequency": "1m",
      "promql": "(histogram_quantile(0.95, sum by (le) (rate({\"http.server.request.duration.bucket\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\",\"http.response.status_code_class\"=~\"^.+$\"}[5m]))) >= 0) or on() vector(0)",
      "summary": "finance_report backend p95 latency of non-probe requests stayed above 3000ms for 10 minutes. Severity P1. Runbook: docs/ssot/ops.observability.md SOP-004C."
    },
    {
      "signal": "metrics",
      "alert_name": "FinanceReportP95LatencyHighStable",
      "service_name": "finance-report-backend",
      "severity": "error",
      "threshold": 3000,
      "threshold_unit": "ms",
      "op": "above",
      "match_type": "all_times",
      "eval_window": "10m0s",
      "frequency": "1m",
      "promql": "(histogram_quantile(0.95, sum by (le) (rate({\"http.server.request.duration.bucket\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\",\"http.route\"!~\"^(/health|/ping|/ping/toggle)$\",\"http.response.status_code\"=~\"^.+$\"}[5m]))) * 1000 >= 0) or on() vector(0)",
      "summary": "finance_report backend p95 latency of non-probe requests stayed above 3000ms for 10 minutes. Severity P1 (reads the stable HTTP metric, seconds, scaled to ms; infra2#1465). Runbook: docs/ssot/ops.observability.md SOP-004C."
    },
    {
      "signal": "metrics",
      "alert_name": "FinanceReportStatementParseFailureSpike",
      "service_name": "finance-report-backend",
      "severity": "error",
      "threshold": 3,
      "threshold_unit": "count",
      "op": "above",
      "match_type": "at_least_once",
      "eval_window": "5m0s",
      "frequency": "1m",
      "promql": "sum(increase({\"finance.statement_parse.outcome\",\"service.name\"=~\"^(finance-report-backend|finance-report-worker)$\",\"deployment.environment.name\"=\"{env}\",\"outcome\"=~\"^(failure|rejected)$\"}[15m]))",
      "summary": "finance_report statement parse failures exceeded 3 in 15 minutes. Severity P1. Runbook: docs/ssot/ops.observability.md SOP-004C."
    },
    {
      "signal": "metrics",
      "alert_name": "FinanceReportRateLimitSaturation",
      "service_name": "finance-report-backend",
      "severity": "warning",
      "threshold": 10,
      "threshold_unit": "count",
      "op": "above",
      "match_type": "at_least_once",
      "eval_window": "5m0s",
      "frequency": "1m",
      "promql": "sum(increase({\"finance.rate_limit.rejected\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\"}[5m]))",
      "summary": "finance_report rate-limit rejections exceeded 10 in 5 minutes. Severity P2. Runbook: docs/ssot/ops.observability.md SOP-004C."
    },
    {
      "signal": "metrics",
      "alert_name": "FinanceReportAsyncTaskFailures",
      "service_name": "finance-report-backend",
      "severity": "error",
      "threshold": 0,
      "threshold_unit": "count",
      "op": "above",
      "match_type": "at_least_once",
      "eval_window": "5m0s",
      "frequency": "1m",
      "promql": "sum(increase({\"finance.async_parse.failure\",\"service.name\"=~\"^(finance-report-backend|finance-report-worker)$\",\"deployment.environment.name\"=\"{env}\"}[5m]))",
      "summary": "finance_report async statement parse task failure was observed. Severity P1. Runbook: docs/ssot/ops.observability.md SOP-004C."
    },
    {
      "signal": "metrics",
      "alert_name": "FinanceReportBackendTelemetryAbsent",
      "service_name": "finance-report-backend",
      "severity": "error",
      "threshold": 0,
      "threshold_unit": "",
      "op": "above",
      "match_type": "at_least_once",
      "eval_window": "5m0s",
      "frequency": "1m",
      "promql": "absent_over_time({\"http.server.request.count\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\"}[10m]) and on() absent_over_time({\"db.pool.size\",\"service.name\"=\"finance-report-backend\",\"deployment.environment.name\"=\"{env}\"}[10m])",
      "summary": "finance-report-backend has reported no request metrics for 10 minutes: the backend is down or its OTLP export stopped, and every other finance_report rule is blind until it recovers. Severity P1 (fires only when both the request counter and the db.pool.size gauge are absent; infra2#1465). Runbook: docs/ssot/ops.observability.md SOP-004C."
    }
  ]
}
