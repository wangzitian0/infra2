{
  "title": "Finance Report — Backend & Frontend",
  "description": "Baseline observability dashboard for finance_report (#373). Covers backend error rate + latency and browser frontend web-vitals + exceptions, sourced from the shared SigNoz collector. Applied via `invoke fr-observability.shared.apply-dashboard`. Services are distinguished by service.name; environments by deployment.environment.",
  "tags": [
    "finance-report",
    "infra2",
    "config-as-code"
  ],
  "version": "v5",
  "variables": {
    "deployment_environment": {
      "type": "QUERY",
      "name": "deployment_environment",
      "description": "deployment.environment (production / staging / pr-N)",
      "multiSelect": true,
      "showALLOption": true,
      "queryValue": "SELECT DISTINCT resources_string['deployment.environment'] FROM signoz_logs.distributed_logs_v2 WHERE resources_string['deployment.environment'] != ''"
    }
  },
  "widgets": [
    {
      "id": "be-error-rate",
      "title": "Backend ERROR/FATAL log rate",
      "description": "Count of finance-report-backend ERROR/FATAL logs (matches the FinanceReportBackendErrorLogs alert).",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "logs",
              "aggregations": [
                {
                  "expression": "count()"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-backend' AND severity_text IN ['ERROR', 'FATAL'] AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "errors"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "be-latency-p95",
      "title": "Backend request latency p95",
      "description": "p95 span duration (durationNano) for finance-report-backend HTTP server spans.",
      "panelTypes": "graph",
      "yAxisUnit": "ns",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "p95(durationNano)"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-backend' AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "p95 latency"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "be-throughput",
      "title": "Backend request rate (RED: Rate)",
      "description": "Request throughput — count of finance-report-backend server spans per step.",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "count()"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-backend' AND kind_string = 'Server' AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "requests"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "be-error-rate-5xx",
      "title": "Backend error span rate (RED: Errors)",
      "description": "Count of finance-report-backend server spans flagged hasError=true (5xx / unhandled).",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "count()"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-backend' AND hasError = true AND kind_string = 'Server' AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "errors"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "be-latency-p50",
      "title": "Backend request latency p50 (RED: Duration)",
      "description": "p50 span duration (durationNano) for finance-report-backend.",
      "panelTypes": "graph",
      "yAxisUnit": "ns",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "p50(durationNano)"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-backend' AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "p50 latency"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "be-latency-p99",
      "title": "Backend request latency p99 (RED: Duration)",
      "description": "p99 span duration (durationNano) for finance-report-backend — tail latency.",
      "panelTypes": "graph",
      "yAxisUnit": "ns",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "p99(durationNano)"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-backend' AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "p99 latency"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "fe-page-load",
      "title": "Frontend page load p75",
      "description": "p75 documentLoad span duration (durationNano) for finance-report-frontend — browser page-load timing.",
      "panelTypes": "graph",
      "yAxisUnit": "ns",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "p75(durationNano)"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-frontend' AND name = 'documentLoad' AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "page load p75"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "fe-web-vitals",
      "title": "Frontend web-vitals p75 (LCP/CLS/INP)",
      "description": "p75 of browser web-vital measurements reported by finance-report-frontend, grouped by metric name.",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "p75(web_vital.value)"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-frontend' AND deployment.environment IN $deployment_environment) AND web_vital.name EXISTS"
              },
              "groupBy": [
                {
                  "dataType": "string",
                  "key": "web_vital.name",
                  "type": "tag"
                }
              ],
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "{{web_vital.name}}"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    },
    {
      "id": "fe-exceptions",
      "title": "Frontend exceptions",
      "description": "Count of browser exception events reported by finance-report-frontend.",
      "panelTypes": "graph",
      "query": {
        "builder": {
          "queryData": [
            {
              "queryName": "A",
              "dataSource": "traces",
              "aggregations": [
                {
                  "expression": "count()"
                }
              ],
              "filter": {
                "expression": "(service.name = 'finance-report-frontend' AND name = 'exception' AND deployment.environment IN $deployment_environment)"
              },
              "having": {
                "expression": ""
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "legend": "exceptions"
            }
          ]
        },
        "queryType": "builder"
      },
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": null,
      "softMax": null,
      "selectedLogFields": null,
      "selectedTracesFields": null
    }
  ],
