{{- /* Generated from truealpha/app by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/truealpha/%s/postgres" $env) }}
DATABASE_URL={{ printf "%q" (printf "postgresql://postgres:%s@truealpha-postgres%s:5432/truealpha" .Data.data.POSTGRES_PASSWORD (env "ENV_SUFFIX")) }}
MIGRATIONS_DATABASE_URL={{ printf "%q" (printf "postgresql://postgres:%s@truealpha-postgres%s:5432/truealpha" .Data.data.POSTGRES_PASSWORD (env "ENV_SUFFIX")) }}
{{- end }}
{{- with secret (printf "secret/data/truealpha/%s/app" $env) }}
SECRET_KEY={{ printf "%q" .Data.data.SECRET_KEY }}
{{ with index .Data.data "S3_ACCESS_KEY" }}S3_ACCESS_KEY={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "S3_SECRET_KEY" }}S3_SECRET_KEY={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "APP_SERVICE_DB_PASSWORD" }}APP_SERVICE_DB_PASSWORD={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "ANTHROPIC_API_KEY" }}ANTHROPIC_API_KEY={{ printf "%q" . }}{{ end }}
{{ with index .Data.data "SEC_USER_AGENT" }}SEC_USER_AGENT={{ printf "%q" . }}{{ end }}
{{- end }}
