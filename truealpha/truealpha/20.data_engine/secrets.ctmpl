{{- $env := env "ENV" -}}
{{- $pg_port := env "TA_POSTGRES_PORT" -}}
{{- $minio_port := env "TA_MINIO_S3_PORT" -}}
{{- with secret (printf "secret/data/truealpha/%s/postgres" $env) -}}
DATABASE_URL={{ printf "%q" (printf "postgresql://postgres:%s@127.0.0.1:%s/truealpha" .Data.data.POSTGRES_PASSWORD $pg_port) }}
{{- end }}
{{- with secret (printf "secret/data/truealpha/%s/data_engine" $env) }}
APP_ENV={{ printf "%q" $env }}
SEC_USER_AGENT={{ printf "%q" .Data.data.SEC_USER_AGENT }}
{{- /* Built from the injected host-loopback port, NOT read from Vault. #602 made
       MinIO publish its S3 API on 19000/19001 for host-network consumers, but the
       Vault value is still "http://127.0.0.1:9000" — written for host-side sweep
       scripts and now simply the wrong port. Deriving it here keeps the dialled
       port and the published port in one place, the same way DATABASE_URL above
       already derives from TA_POSTGRES_PORT. */}}
S3_ENDPOINT={{ printf "%q" (printf "http://127.0.0.1:%s" $minio_port) }}
S3_ACCESS_KEY={{ printf "%q" .Data.data.S3_ACCESS_KEY }}
S3_SECRET_KEY={{ printf "%q" .Data.data.S3_SECRET_KEY }}
S3_BUCKET={{ printf "%q" .Data.data.S3_BUCKET }}
S3_REGION={{ with .Data.data.S3_REGION }}{{ printf "%q" . }}{{ else }}"us-east-1"{{ end }}
{{- /* Second independent price origin for market-price reconciliation
       (truealpha live_topt_pipeline reads TWELVE_DATA_API_KEY from the env;
       empty disables the origin and reconciliation degrades to 0 — optional
       by contract, seeded from 1Password for staging+production). */}}
TWELVE_DATA_API_KEY={{ with .Data.data.TWELVE_DATA_API_KEY }}{{ printf "%q" . }}{{ else }}""{{ end }}
OPENFIGI_API_KEY={{ with .Data.data.OPENFIGI_API_KEY }}{{ printf "%q" . }}{{ else }}""{{ end }}
MOOMOO_MONTHLY_CALL_BUDGET={{ with .Data.data.MOOMOO_MONTHLY_CALL_BUDGET }}{{ printf "%q" . }}{{ else }}"20000"{{ end }}
MOOMOO_CALLS_PER_30S={{ with .Data.data.MOOMOO_CALLS_PER_30S }}{{ printf "%q" . }}{{ else }}"8"{{ end }}
{{- /* The filing-extraction model provider (truealpha#70 scope 1, owner decision
       2026-09-07: the Zhipu GLM coding plan). Optional by contract: an empty key
       seats no provider and the loop keeps every multi-candidate filing as
       needs_model_selection. The base URL / model / provider label are versioned
       parameters that travel into every invocation record (init.md §9). */}}
LLM_API_KEY={{ with .Data.data.LLM_API_KEY }}{{ printf "%q" . }}{{ else }}""{{ end }}
LLM_BASE_URL={{ with .Data.data.LLM_BASE_URL }}{{ printf "%q" . }}{{ else }}"https://open.bigmodel.cn/api/coding/paas/v4"{{ end }}
LLM_MODEL={{ with .Data.data.LLM_MODEL }}{{ printf "%q" . }}{{ else }}"glm-4.7"{{ end }}
LLM_PROVIDER={{ with .Data.data.LLM_PROVIDER }}{{ printf "%q" . }}{{ else }}"zhipu-glm-coding-plan"{{ end }}
{{- end }}
