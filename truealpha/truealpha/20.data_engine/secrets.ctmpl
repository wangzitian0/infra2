{{- /* Generated from truealpha/data_engine by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/truealpha/%s/postgres" $env) }}
DATABASE_URL={{ printf "%q" (printf "postgresql://postgres:%s@127.0.0.1:%s/truealpha" .Data.data.POSTGRES_PASSWORD (env "TA_POSTGRES_PORT")) }}
{{- end }}
{{- with secret (printf "secret/data/truealpha/%s/data_engine" $env) }}
{{ with .Data.data.S3_ACCESS_KEY }}S3_ACCESS_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.S3_SECRET_KEY }}S3_SECRET_KEY={{ printf "%q" . }}{{ end }}
SEC_USER_AGENT={{ printf "%q" .Data.data.SEC_USER_AGENT }}
{{ with .Data.data.OPENFIGI_API_KEY }}OPENFIGI_API_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.TWELVE_DATA_API_KEY }}TWELVE_DATA_API_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.LLM_API_KEY }}LLM_API_KEY={{ printf "%q" . }}{{ end }}
{{- end }}
