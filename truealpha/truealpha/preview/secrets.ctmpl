{{- /* Generated from truealpha/app by infra2_sdk.secrets. Do not edit. */ -}}
{{- $env := env "ENV" -}}
{{- with secret (printf "secret/data/truealpha/%s/app" "staging") }}
SECRET_KEY={{ printf "%q" .Data.data.SECRET_KEY }}
{{ with .Data.data.S3_ACCESS_KEY }}S3_ACCESS_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.S3_SECRET_KEY }}S3_SECRET_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.APP_SERVICE_DB_PASSWORD }}APP_SERVICE_DB_PASSWORD={{ printf "%q" . }}{{ end }}
{{ with .Data.data.ANTHROPIC_API_KEY }}ANTHROPIC_API_KEY={{ printf "%q" . }}{{ end }}
{{ with .Data.data.SEC_USER_AGENT }}SEC_USER_AGENT={{ printf "%q" . }}{{ end }}
{{- end }}
